name = "azure-openai-responses-proxy"
main = "src/index.ts"
compatibility_date = "2026-01-01"
compatibility_flags = ["nodejs_compat"]

[vars]
# --- Azure OpenAI (Upstream) ---
# Base URL of your upstream. Either the official Azure OpenAI endpoint or
# any compatible reverse proxy that speaks the Azure Chat Completion shape:
#   {endpoint}/openai/deployments/{deployment}/chat/completions?api-version=...
AZURE_ENDPOINT = "https://your-resource.openai.azure.com"

# Default REST api-version (used as ?api-version=<value> query string).
# See https://learn.microsoft.com/azure/ai-services/openai/reference for the
# current GA version. Stable: 2024-10-21. Newer (preview): 2025-04-01-preview.
AZURE_API_VERSION = "2024-10-21"

# How the upstream gateway authenticates:
#   "api-key"           – sends "api-key: <token>" (default Azure OpenAI)
#   "authorization"     – sends "Authorization: Bearer <token>" (AAD / OAuth)
AZURE_AUTH_HEADER = "api-key"

# AZURE_API_KEY = "..."         # Secret. Use `wrangler secret put AZURE_API_KEY`

# --- General ---
# Default deployment name to use when client omits model.
DEFAULT_MODEL = "gpt-4o"

# Comma-separated list of deployment names exposed by /v1/models.
EXPOSED_MODELS = "gpt-4o,gpt-4o-mini,gpt-5,o3-mini"

ENABLE_STREAMING = true
DEBUG_LOG = false

# Optional: protect the worker with a Bearer token.
# API_KEY = "sk-..."            # Set via `wrangler secret put API_KEY`

[observability.logs]
enabled = true
head_sampling_rate = 1
persist = true
invocation_logs = true

[observability.traces]
enabled = false
persist = true
head_sampling_rate = 1
