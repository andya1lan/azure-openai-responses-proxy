  "description": "Cloudflare Worker that proxies Azure OpenAI Chat Completion API and exposes both OpenAI Chat Completion API and the new OpenAI Responses API",
  "main": "src/index.ts",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev"
  },
