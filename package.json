    "cloudflare-worker",
    "azure-openai",
    "openai",
    "responses-api",
    "chat-completions",
    "proxy"
  ],
  "author": "Andy Allan",
  "license": "MIT",
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260530.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7",
    "wrangler": "^4.95.0"
  }
}
